{
    "name": "@sigx/three-runtime",
    "version": "0.1.0",
    "description": "three.js renderer for SignalX — scene-graph host ops, frame loop, raycast pointer events and JSX intrinsics",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./internals": {
            "types": "./dist/internals.d.ts",
            "development": "./dist/internals.js",
            "production": "./dist/internals.prod.js",
            "import": "./dist/internals.js"
        },
        "./platform": {
            "types": "./dist/platform.d.ts",
            "development": "./dist/platform.js",
            "production": "./dist/platform.prod.js",
            "import": "./dist/platform.js"
        },
        "./jsx-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "development": "./dist/jsx-runtime.js",
            "production": "./dist/jsx-runtime.prod.js",
            "import": "./dist/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "development": "./dist/jsx-runtime.js",
            "production": "./dist/jsx-runtime.prod.js",
            "import": "./dist/jsx-runtime.js"
        },
        "./webgl": {
            "types": "./dist/webgl.d.ts",
            "development": "./dist/webgl.js",
            "production": "./dist/webgl.prod.js",
            "import": "./dist/webgl.js"
        },
        "./webgpu": {
            "types": "./dist/webgpu.d.ts",
            "development": "./dist/webgpu.js",
            "production": "./dist/webgpu.prod.js",
            "import": "./dist/webgpu.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/platform.js",
        "./dist/platform.prod.js",
        "./dist/platform-*.js",
        "./dist/platform-*.prod.js",
        "./dist/jsx-runtime.js",
        "./dist/jsx-runtime.prod.js"
    ],
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsgo --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "three",
        "threejs",
        "renderer",
        "webgl",
        "webgpu",
        "3d",
        "tsx"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/three.git",
        "directory": "packages/three-runtime"
    },
    "homepage": "https://sigx.dev/three/",
    "bugs": {
        "url": "https://github.com/signalxjs/three/issues"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "peerDependencies": {
        "@sigx/reactivity": "^1.0.0",
        "@sigx/runtime-core": "^1.0.0",
        "three": ">=0.160.0"
    },
    "devDependencies": {
        "@sigx/reactivity": "catalog:",
        "@sigx/runtime-core": "catalog:",
        "@sigx/vite": "catalog:",
        "@types/node": "^22.0.0",
        "@types/three": "^0.186.0",
        "three": "^0.186.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
