{
    "name": "@sigx/three",
    "version": "0.1.0",
    "description": "three.js for SignalX apps — <Canvas>, useFrame/useThree, asset loading, input and instancing composables on top of @sigx/three-runtime",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsgo --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "three",
        "threejs",
        "canvas",
        "game",
        "webgl",
        "webgpu",
        "3d",
        "tsx"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/three.git",
        "directory": "packages/three"
    },
    "homepage": "https://sigx.dev/three/",
    "bugs": {
        "url": "https://github.com/signalxjs/three/issues"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "@sigx/three-runtime": "workspace:^"
    },
    "peerDependencies": {
        "@sigx/reactivity": "^1.0.0",
        "@sigx/runtime-core": "^1.0.0",
        "@sigx/runtime-dom": "^1.0.0",
        "@types/three": ">=0.160.0",
        "three": ">=0.160.0"
    },
    "peerDependenciesMeta": {
        "@types/three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@sigx/reactivity": "catalog:",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/vite": "catalog:",
        "@types/node": "^22.0.0",
        "@types/three": "^0.185.4",
        "three": "^0.186.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
