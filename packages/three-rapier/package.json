{
    "name": "@sigx/three-rapier",
    "version": "0.1.0",
    "description": "Rapier physics for @sigx/three — <Physics>, <RigidBody>, <Collider>, collision events and a debug renderer on a fixed-timestep loop",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsgo --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "three",
        "threejs",
        "rapier",
        "physics",
        "game",
        "3d"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/three.git",
        "directory": "packages/three-rapier"
    },
    "homepage": "https://sigx.dev/three/",
    "bugs": {
        "url": "https://github.com/signalxjs/three/issues"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "peerDependencies": {
        "@dimforge/rapier3d-compat": ">=0.14.0",
        "@sigx/reactivity": "^0.15.0",
        "@sigx/runtime-core": "^0.15.0",
        "@sigx/runtime-three": "workspace:^",
        "@sigx/three": "workspace:^",
        "three": ">=0.160.0"
    },
    "devDependencies": {
        "@dimforge/rapier3d-compat": "^0.20.0",
        "@sigx/reactivity": "catalog:",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-three": "workspace:^",
        "@sigx/three": "workspace:^",
        "@sigx/vite": "catalog:",
        "@types/node": "^22.0.0",
        "@types/three": "^0.185.4",
        "three": "^0.186.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
