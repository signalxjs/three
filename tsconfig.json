{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@sigx/runtime-core",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@sigx/three-runtime/internals": ["./packages/three-runtime/src/internals.ts"],
      "@sigx/three-runtime/platform": ["./packages/three-runtime/src/platform.ts"],
      "@sigx/three-runtime/jsx-runtime": ["./packages/three-runtime/src/jsx-runtime.ts"],
      "@sigx/three-runtime/jsx-dev-runtime": ["./packages/three-runtime/src/jsx-runtime.ts"],
      "@sigx/three-runtime/webgl": ["./packages/three-runtime/src/webgl.ts"],
      "@sigx/three-runtime/webgpu": ["./packages/three-runtime/src/webgpu.ts"],
      "@sigx/three-runtime": ["./packages/three-runtime/src/index.ts"],
      "@sigx/three": ["./packages/three/src/index.ts"],
      "@sigx/three-rapier": ["./packages/three-rapier/src/index.ts"]
    }
  },
  "include": [
    "env.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/__tests__/**/*.ts",
    "packages/*/__tests__/**/*.tsx",
    "packages/*/benchmarks/**/*.ts",
    "packages/*/benchmarks/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "examples"]
}
